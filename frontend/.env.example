# Production Vercel : le frontend appelle directement le backend Render, sans rewrite /api Vercel.
# Développement local possible : http://127.0.0.1:8000/api.
VITE_API_BASE_URL=https://mapgeogroup.onrender.com/api
# En production, le refresh token doit rester en cookie HttpOnly et ne jamais être stocké en JavaScript.
VITE_USE_REFRESH_COOKIE=true
# memory = access token en mémoire JS uniquement ; session = compatibilité ancienne sessionStorage.
VITE_ACCESS_TOKEN_STORAGE=memory
# Cible du proxy Vite en développement local.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
# Ancien nom encore accepté par le code: VITE_API_URL
# Basemap overrides (JSON strings)
VITE_VECTOR_TILE={"url":"https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png","attribution":"&copy; OpenStreetMap contributors &copy; CARTO"}
VITE_LABEL_TILE={"url":"https://mt1.google.com/vt/lyrs=h&x={x}&y={y}&z={z}","attribution":"&copy; Google","opacity":0.9,"maxNativeZoom":22,"maxZoom":22,"detectRetina":false}
VITE_SATELLITE_TILE={"url":"https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}","attribution":"&copy; Google","maxNativeZoom":22,"maxZoom":22,"detectRetina":false}
# External business layers (WMS or XYZ)
VITE_SIG_LAYERS=[{"name":"Occupation du sol","url":"https://your-server/tiles/occupation_sol/{z}/{x}/{y}.png","attribution":"MAPGEO SIG","defaultVisible":true,"opacity":0.8},{"name":"Cadastre WMS","type":"wms","url":"https://your-server/geoserver/wms","layers":"workspace:cadastre","attribution":"MAPGEO SIG","defaultVisible":false,"opacity":0.75}]


# WMS cadastre utilisé par le groupe Fonds > Cadastre.
VITE_CADASTRE_WMS_URL=
VITE_CADASTRE_WMS_LAYERS=CADASTRALPARCELS.PARCELLAIRE_EXPRESS

# Exemple de catalogue SIG métier.
# Groupes possibles : cadastre, zonage, risques, reseaux, documents.
# Chaque couche peut définir visible, opacity, minZoom, maxZoom, extent, metadata et legend.
# VITE_SIG_LAYERS=[{"id":"plu-zonage","name":"Zonage PLU","group":"zonage","type":"wms","url":"https://example.com/geoserver/wms","layers":"urbanisme:plu","visible":false,"opacity":0.65,"minZoom":12,"metadata":{"source":"Service urbanisme","date":"2026-04-25","projection":"EPSG:3857","owner":"Commune","licence":"ODbL"},"legend":[{"label":"Zone urbaine","symbol":"polygon","color":"#7c3aed","fillColor":"#ede9fe"}],"extent":[[48.70,2.10],[48.95,2.55]]}]

# Contrôles cadastraux de l'éditeur géométrique.
# Le projet utilise EPSG:32628 : les bornes doivent donc être en mètres [minX,minY,maxX,maxY], pas en degrés GPS.
# Exemple Sénégal / UTM 28N à ajuster selon votre zone métier :
# VITE_GEOMETRY_EXPECTED_BOUNDS=[160000,1300000,900000,1900000]
VITE_GEOMETRY_EXPECTED_BOUNDS=
VITE_GEOMETRY_MIN_AREA_M2=1

# Fond OSM utilise a la place de l'ancien fond relief.
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OSM_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Google Identity Services - Client ID Web Google Cloud, identique au backend GOOGLE_OAUTH_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
