# Copier ce fichier en .env pour le développement local uniquement.
# Ne jamais versionner .env. En production, définir ces variables dans l'hébergeur.

# Environnement / sécurité Django
DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-generated-for-this-environment
DJANGO_ALLOWED_HOSTS=api.example.com,backend.example.com
DJANGO_TIME_ZONE=Africa/Dakar

# Frontend / CORS / CSRF
# Same-origin avec reverse proxy : garder CORS vide.
# Frontend sur un autre domaine : ajouter l'origine exacte, sans slash final.
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com
DJANGO_CORS_ALLOW_ALL_ORIGINS=False
DJANGO_CORS_ALLOW_CREDENTIALS=True

# Base de données PostgreSQL/PostGIS
# Obligatoire en production : ne pas utiliser SQLite.
# Le projet utilise des GeometryField : PostGIS doit rester activé.
USE_POSTGIS=True
DATABASE_URL=postgis://mapgeo_user:replace-with-db-password@db.example.com:5432/mapgeo_db
DB_SCHEMA=donnees_mapgeo
DB_CONN_MAX_AGE=60

# Redis — requis en production pour le throttling anti-brute-force partagé entre workers
REDIS_URL=redis://localhost:6379/0

# GeoDjango Windows local avec OSGeo4W uniquement.
# Ne pas définir ces variables sur Render/Linux/Docker si les libs système sont installées.
# GDAL_LIBRARY_PATH=C:\OSGeo4W\bin\gdal308.dll
# GEOS_LIBRARY_PATH=C:\OSGeo4W\bin\geos_c.dll

# API / Auth JWT
API_PAGE_SIZE=20
MAP_VIEWPORT_PAGE_SIZE=500
MAP_VIEWPORT_MAX_PAGE_SIZE=1000
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
JWT_REFRESH_COOKIE_ENABLED=True
JWT_REFRESH_COOKIE_BODY_ENABLED=True
JWT_REFRESH_COOKIE_NAME=mapgeo_refresh
JWT_REFRESH_COOKIE_PATH=/api/auth/refresh/
JWT_REFRESH_COOKIE_SAMESITE=Lax
JWT_REFRESH_COOKIE_SECURE=True
PUBLIC_REGISTRATION_ENABLED=False

# Email / notifications
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True


# Content-Security-Policy backend/API. Le frontend Nginx définit aussi sa CSP.
SECURITY_CSP_ENABLED=True
SECURITY_CSP_REPORT_ONLY=False
# SECURITY_CSP=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
# Sécurité HTTP production
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_PROXY_SSL_HEADER=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# Sécurité connexion
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TIMEOUT_SECONDS=900
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_WINDOW_MINUTES=30
ACTIVATION_MAX_ATTEMPTS=8
ACTIVATION_WINDOW_MINUTES=30

# Imports / jobs
IMPORT_QUEUE_POLL_SECONDS=10
IMPORT_QUEUE_BATCH_SIZE=3
IMPORT_PREVIEW_CONFIRM_REQUIRED=True

# Google OAuth / Google Identity Services
# Créez un Client ID Web dans Google Cloud Console et renseignez le même côté frontend.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CREATE_CLIENTS=False

# Tables SIG métier optionnelles, au format JSON.
# Tables SIG dans le schéma DB_SCHEMA.
MAP_LAYER_TABLES={"communes":"communes","roads":"reseau_routier","sanitary-infrastructures":"infrastructures sanitaires","school-infrastructures":"infrastructures scolaires"}
EXTERNAL_MAP_PROXY_MAX_BYTES=20971520
# Production : allowlist obligatoire pour les hôtes WMS/WFS externes hors GEOSERVER_WMS_URL.
# Exemple : EXTERNAL_MAP_PROXY_ALLOWED_HOSTS=geoserver.example.com,wfs.partner.example.org
EXTERNAL_MAP_PROXY_ALLOWED_HOSTS=

# Upload couches cartographiques privées client
MAX_VECTOR_UPLOAD_SIZE=20971520
MAX_GEOJSON_FEATURES=50000
MAX_IMAGE_OVERLAY_UPLOAD_SIZE=104857600
MAX_RASTER_UPLOAD_SIZE=524288000
MAX_MBTILES_UPLOAD_SIZE=1073741824
MAX_MAP_LAYER_UPLOAD_SIZE=209715200

# Import portefeuille PostGIS : si le formulaire admin ne fournit pas ces champs,
# le backend utilise DATABASE_URL/DB_SCHEMA. Ces variables sont optionnelles.
POSTGIS_IMPORT_DEFAULT_HOST=127.0.0.1
POSTGIS_IMPORT_DEFAULT_PORT=5432
POSTGIS_IMPORT_DEFAULT_DATABASE=mapgeo_db
POSTGIS_IMPORT_DEFAULT_USER=mapgeo
POSTGIS_IMPORT_DEFAULT_SCHEMA=donnees_mapgeo

# Throttling DRF global (requêtes/minute)
DRF_THROTTLE_ANON=60/minute
DRF_THROTTLE_USER=300/minute
